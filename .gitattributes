# Перевод концов строк нормализуется автоматически
* text=auto eol=lf

# Бинарники без diff/merge
*.pdf binary
*.jpg binary
*.jpeg binary
*.png binary
*.mp3 binary
*.mp4 binary
*.zip binary

# === Git LFS (по желанию) ===
# Раскомментируй после `brew install git-lfs && git lfs install`,
# если хочешь хранить PDF в репозитории. Подробнее — GIT-WORKFLOW.md.
# *.pdf filter=lfs diff=lfs merge=lfs -text
